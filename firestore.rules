rules_version = '2';

// ZennCode portfolio — Firestore rules.
//
//   communityMessages  public guestbook: public read, validated append-only
//                      writes, owner-only delete (moderation).
//   siteStats/{key}    private counters: `total` and `day-YYYY-MM-DD`.
//                      Anyone may +1 their own session's counter, only the
//                      owner may read.
//   visits/{autoId}    private recent-visitor feed. Anyone may append one
//                      coarse record per session, only the owner may read.
//
// `isOwner()` is the single gate behind every private read/write. It keys off
// the signed-in account's email claim, which only Firebase Auth can mint — so
// the check cannot be satisfied by anything in the client bundle.
//
// Adding another admin: add their email to the list below and redeploy rules.

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
             'zenjanarce8@gmail.com'
           ];
    }

    // ── Community chat guestbook ───────────────────────────────────────────
    match /communityMessages/{messageId} {
      allow read: if true;

      // Only the fields we expect — otherwise a client can attach arbitrary
      // extra keys/values (up to the 1 MiB doc limit) to every write.
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'text', 'location', 'countryCode', 'seed', 'createdAt'
        ])
        // No auth in this app, so `name` is self-asserted. Keep it honest-ish.
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 60
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() <= 4
        && request.resource.data.seed is string
        && request.resource.data.seed.size() <= 40
        // createdAt MUST be a serverTimestamp() written by the client, so the
        // value is resolved by the server and cannot be forged. Without this,
        // an anonymous client could write a far-future timestamp and, because
        // the feed queries orderBy('createdAt','desc') + limit(200), those
        // docs would become the entire result set for every reader — and they
        // can never be removed (update/delete are denied below), so the chat
        // would stay blank permanently.
        // The window is a sanity bound; it cannot be widened by the client.
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt <= request.time
        && request.resource.data.createdAt > request.time - duration.value(10, 'm');

      // No edits. Deletes are owner-only moderation.
      allow update: if false;
      allow delete: if isOwner();
    }

    // ── Private visit counters ─────────────────────────────────────────────
    // Shaped so the ONLY thing an anonymous client can do is +1 a counter:
    // `count` must be exactly one more than what's stored, and the document id
    // must be `total` or a real calendar day, so nobody can invent keys or
    // jump the numbers.
    match /siteStats/{key} {
      allow read: if isOwner();

      allow create: if (key == 'total'
          || key.matches('day-[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]'))
        && request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count == 1
        && request.resource.data.updatedAt == request.time;

      allow update: if request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner();
    }

    // ── Private recent-visitor feed ────────────────────────────────────────
    // Append-only, fixed shape, and deliberately coarse: language + viewport
    // size + referrer host + landing path. No IP, no user agent, no
    // fingerprint — see src/lib/adminData.ts.
    match /visits/{visitId} {
      allow read: if isOwner();

      allow create: if request.resource.data.keys().hasOnly([
          'createdAt', 'visitorId', 'visitCount', 'device', 'os', 'browser',
          'viewport', 'lang', 'timezone', 'entry', 'referrer', 'source',
          'city', 'country', 'countryCode'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() <= 16
        && request.resource.data.visitCount is int
        && request.resource.data.visitCount >= 1
        && request.resource.data.visitCount <= 100
        && request.resource.data.device in ['mobile', 'tablet', 'desktop']
        && request.resource.data.os is string
        && request.resource.data.os.size() <= 40
        && request.resource.data.browser is string
        && request.resource.data.browser.size() <= 40
        && request.resource.data.viewport is string
        && request.resource.data.viewport.size() <= 16
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 20
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() <= 60
        && request.resource.data.entry is string
        && request.resource.data.entry.size() <= 120
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 120
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 60
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 60
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 60
        && request.resource.data.countryCode is string
        && request.resource.data.countryCode.size() <= 4;

      allow update, delete: if false;
    }

    // ── Private link-click feed ────────────────────────────────────────────
    // One document per click, stamped with the visitor id so the dashboard can
    // answer "who clicked what" by joining against `visits`, plus the session's
    // traffic source so the FROM column can say Facebook/TikTok/Search instead
    // of the page the click happened on. Deliberately no device/location here —
    // those are looked up from the visit instead of being written twice.
    match /linkClicks/{clickId} {
      allow read: if isOwner();

      allow create: if request.resource.data.keys().hasOnly([
          'createdAt', 'visitorId', 'visitCount', 'label', 'target', 'path',
          'source'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.visitorId is string
        && request.resource.data.visitorId.size() <= 16
        && request.resource.data.visitCount is int
        && request.resource.data.visitCount >= 1
        && request.resource.data.visitCount <= 100
        && request.resource.data.label is string
        && request.resource.data.label.size() > 0
        && request.resource.data.label.size() <= 60
        && request.resource.data.target is string
        && request.resource.data.target.size() > 0
        && request.resource.data.target.size() <= 120
        && request.resource.data.path is string
        && request.resource.data.path.size() <= 120
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 60;

      allow update, delete: if false;
    }

    // Everything else stays locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
